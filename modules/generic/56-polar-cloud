#!/bin/bash
set -xe
export LC_ALL=C

########################################
# Functions and Basic Configuration    #
########################################

# Load common functions and set up cleanup trap
source /common.sh
install_cleanup_trap

# Load additional configuration (e.g., BASE_USER)
source /files/00-config

########################################
# Configuration                        #
########################################

# General settings
readonly DEPS=(python3-pip python3-venv git python3-websockets python3-pycryptodome python3-requests python3-pil)

########################################
# Install System Packages              #
########################################

apt-get install --yes "${DEPS[@]}"

########################################
# Create Polar Cloud Service           #
########################################

pushd "/home/${BASE_USER}" &> /dev/null || exit 1

# Create polar-cloud directory
sudo -u "${BASE_USER}" mkdir -p polar-cloud

# Create Python virtual environment
sudo -u "${BASE_USER}" python3 -m venv polar-cloud/venv

# Install Python dependencies
sudo -u "${BASE_USER}" polar-cloud/venv/bin/pip install --upgrade pip
sudo -u "${BASE_USER}" polar-cloud/venv/bin/pip install websockets pycryptodome requests pillow aiohttp

popd &> /dev/null || exit 1

########################################
# Copy Polar Cloud Files               #
########################################

# Copy service files
cp /files/polar-cloud/polar_cloud.py "/home/${BASE_USER}/polar-cloud/"
cp /files/polar-cloud/polar_cloud.service "/etc/systemd/system/"
cp /files/polar-cloud/polar_cloud.conf "/home/${BASE_USER}/printer_data/config/"

# Create moonraker plugins directory and copy plugin
sudo -u "${BASE_USER}" mkdir -p "/home/${BASE_USER}/printer_data/moonraker/plugins"
cp /files/polar-cloud/polar_cloud_moonraker.py "/home/${BASE_USER}/printer_data/moonraker/plugins/"

# Copy simple web interface
sudo -u "${BASE_USER}" mkdir -p "/home/${BASE_USER}/polar-cloud/web"
cp /files/polar-cloud/polar_cloud_web.html "/home/${BASE_USER}/polar-cloud/web/index.html"

# Fix ownership
chown -R "${BASE_USER}:${BASE_USER}" "/home/${BASE_USER}/polar-cloud"
chown "${BASE_USER}:${BASE_USER}" "/home/${BASE_USER}/printer_data/config/polar_cloud.conf"
chown "${BASE_USER}:${BASE_USER}" "/home/${BASE_USER}/printer_data/moonraker/plugins/polar_cloud_moonraker.py"

########################################
# Enable Service                       #
########################################

systemctl_if_exists enable polar_cloud.service

########################################
# Add Moonraker Update Manager Entry   #
########################################

# Add update manager entry to moonraker.conf if it doesn't exist
if ! grep -q "\[update_manager polar_cloud\]" "${MOONRAKER_CONFIG}" 2>/dev/null; then
    cat >> "${MOONRAKER_CONFIG}" << 'EOF'

[update_manager polar_cloud]
type: git_repo
channel: stable
path: ~/polar-cloud
origin: https://github.com/mainsail-crew/polar-cloud.git
primary_branch: main
managed_services: polar_cloud
EOF
fi

# Add Moonraker plugin configuration if it doesn't exist
if ! grep -q "\[polar_cloud\]" "${MOONRAKER_CONFIG}" 2>/dev/null; then
    cat >> "${MOONRAKER_CONFIG}" << 'EOF'

[polar_cloud]
# Polar Cloud plugin configuration
enabled: True
EOF
fi

# Add the plugin include directive if it doesn't exist
if ! grep -q "polar_cloud_moonraker" "${MOONRAKER_CONFIG}" 2>/dev/null; then
    # Check if there's already an [include] section
    if grep -q "^\[include" "${MOONRAKER_CONFIG}" 2>/dev/null; then
        # Add to existing include section
        sed -i '/^\[include/a polar_cloud_moonraker.py' "${MOONRAKER_CONFIG}"
    else
        # Create new include section
        cat >> "${MOONRAKER_CONFIG}" << 'EOF'

[include polar_cloud_moonraker.py]
EOF
    fi
fi

########################################
# Add Nginx Configuration              #
########################################

# Add Polar Cloud web interface to nginx config
if [ -f "/etc/nginx/sites-available/mainsail" ]; then
    # Check if polar cloud location already exists
    if ! grep -q "location /polar-cloud" "/etc/nginx/sites-available/mainsail"; then
        # Add polar cloud location before the last closing brace
        sed -i '/^}$/i\
\
    # Redirect /polar-cloud to /polar-cloud/ for user-friendliness\
    location = /polar-cloud {\
        return 301 $scheme://$host/polar-cloud/;\
    }\
\
    location /polar-cloud/ {\
        alias /home/pi/polar-cloud/web/;\
        try_files $uri $uri/ /polar-cloud/index.html;\
    }' "/etc/nginx/sites-available/mainsail"
        
        # Restart nginx to apply changes
        systemctl restart nginx || true
    fi
fi 